# Quantum Vault deployer (TESTNET ONLY). Copy to ../.env (OUTSIDE the repo)
# and fill in real values. Never commit a real mnemonic or private key.
QORE_NETWORK=testnet
QORE_EVM_RPC_URL=https://evm-testnet.qore.host
QORE_MNEMONIC=
QORE_EVM_PRIVATE_KEY=
QORE_WINDOW_BLOCKS=1200
QORE_WINDOW_TXS=10
# Build-time contract address for the frontend (public, not a secret):
# VITE_QUANTUM_VAULT_ADDRESS=0x...
